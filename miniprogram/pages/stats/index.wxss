.stats { padding-top: 24px; }
.stats .page-title { margin-bottom: 8px; }
.week-navigation { margin-top: 20px; padding: 12px; }
.week-label { width: 100%; min-width: 0; color: var(--color-text); font-size: 14px; font-weight: 600; text-align: center; line-height: 1.6; overflow-wrap: break-word; }
.week-controls { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
.stats button.week-control, .stats button.current-week { flex: 1 1 0; width: 0; min-width: 0; max-width: none; min-height: 44px; height: auto; margin: 0; padding: 11px 4px; box-sizing: border-box; border-radius: 10px; font-size: 14px; line-height: 1.6; text-align: center; white-space: normal; display: flex; align-items: center; justify-content: center; }
.stats button.week-control { background: #F2F4F7; color: #344054; }
.stats button.current-week { background: var(--color-primary-soft); color: var(--color-primary); }
.overview { margin-top: 12px; background: var(--color-surface); }
.overview-label { color: var(--color-muted); font-size: 14px; }
.overview-number { font-weight: 700; font-size: 48px; line-height: 1.3; color: var(--color-text); margin-top: 8px; }
.percent-sign { font-size: 23px; margin-left: 2px; }
.progress-track, .day-progress { border-radius: 8px; background: #E5E7EB; height: 7px; overflow: hidden; }
.progress-track { margin-top: 18px; }
.progress-fill { background: var(--color-primary); height: 100%; }
.training-count { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--color-training); margin-top: 12px; }
.training-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-training); flex-shrink: 0; }
.overview-footnote { margin-top: 8px; color: var(--color-muted); font-size: 12px; line-height: 1.7; }
.day { margin-bottom: 10px; }
.day-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; column-gap: 10px; row-gap: 4px; margin-bottom: 12px; font-size: 14px; font-weight: 600; }
.day-date { min-width: 0; overflow-wrap: break-word; }
.count { color: var(--color-muted); font-weight: 400; white-space: nowrap; }
.day-progress { height: 6px; background: #EAECF0; }
.day-progress-fill { background: var(--color-success); height: 100%; }
.tip { color: var(--color-muted); font-size: 13px; line-height: 1.8; padding: 8px 4px; }
.metric-grid { display: flex; gap: 12px; }
.metric { flex: 1; min-width: 0; text-align: center; margin-bottom: 0; padding: 14px 10px; }
.metric-number { color: var(--color-text); font-size: 28px; font-weight: 700; overflow-wrap: anywhere; }
.metric-number text { font-size: 13px; font-weight: 400; margin-left: 4px; }
.metric-label { font-size: 13px; color: var(--color-muted); margin-top: 4px; }
.streak-help { padding: 4px; margin-top: 8px; }
.stats-error { margin-top: 12px; padding: 12px; color: var(--color-danger); background: var(--color-danger-soft); border-radius: 10px; font-size: 14px; line-height: 1.7; }
.form-grid { display: flex; flex-wrap: wrap; gap: 12px; }
.history-date { min-width: 0; flex: 1 1 180px; }
.history-date .form-picker { white-space: nowrap; font-variant-numeric: tabular-nums; }
.stats .history-apply { width: 100%; max-width: 100%; margin-top: 14px; }
.history-count { color: var(--color-muted); font-size: 13px; margin: 0 4px 10px; }
.history-day-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-top: 4px; font-size: 13px; color: var(--color-training); }
.stats button.history-details { width: auto; min-width: 88px; max-width: 100%; flex: 0 0 auto; min-height: 44px; padding: 10px 12px; margin: 0; color: var(--color-primary); font-size: 13px; background: transparent; display: flex; align-items: center; justify-content: center; }
.history-limit { margin-bottom: 12px; }
.record-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
.record-date { color: var(--color-muted); font-size: 13px; }
.record-status { color: var(--color-muted); font-size: 13px; background: #F2F4F7; padding: 3px 9px; border-radius: 12px; }
.status-doing { color: var(--color-primary); background: var(--color-primary-soft); }
.status-done { color: var(--color-success); background: var(--color-success-soft); }
.status-deferred { color: var(--color-warning); background: var(--color-warning-soft); }
.status-aborted { color: var(--color-danger); background: var(--color-danger-soft); }
.record-title { margin: 10px 0 12px; font-size: 16px; font-weight: 600; line-height: 1.6; overflow-wrap: break-word; }
.actual-time { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: 12px; row-gap: 3px; margin-top: 6px; color: var(--color-muted); font-size: 13px; }
.actual-time text:last-child { text-align: right; overflow-wrap: break-word; }
.record-note, .record-feedback { margin-top: 10px; font-size: 13px; color: var(--color-muted); line-height: 1.8; overflow-wrap: break-word; }
.stats .record-events-toggle { width: 100%; max-width: 100%; margin-top: 12px; min-height: 44px; padding: 10px; border-radius: 10px; background: #F2F4F7; color: var(--color-primary); font-size: 13px; white-space: normal; }
.record-events { margin-top: 12px; border-top: 1px solid var(--color-border); }
.record-event { padding: 10px 0; font-size: 14px; color: #344054; }
.record-event + .record-event { border-top: 1px solid #F2F4F7; }
.event-time, .event-reason { margin-top: 4px; font-size: 12px; color: var(--color-muted); line-height: 1.8; overflow-wrap: break-word; }
@media (max-width: 360px) {
  .stats .week-navigation { padding: 12px 8px; }
  .week-controls { gap: 6px; }
  .stats button.week-control, .stats button.current-week { padding-left: 2px; padding-right: 2px; font-size: 13px; }
  .metric-grid { gap: 8px; }
}
