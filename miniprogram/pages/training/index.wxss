.training { padding-top: 48rpx; }
.eyebrow { font-size: 20rpx; color: #278078; font-weight: 800; letter-spacing: 5rpx; margin-bottom: 15rpx; }
.training .page-title { margin-bottom: 14rpx; }
.summary { margin-top: 34rpx; }
.summary-label { font-size: 23rpx; color: #668481; }
.summary-numbers { font-size: 46rpx; color: #2B7B72; font-weight: 720; margin: 12rpx 0 22rpx; }
.small { font-size: 22rpx; font-weight: 400; }
.progress-track { height: 12rpx; background: #E3EFEC; border-radius: 12rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #257B72; }
.alert { background: #FFF4E4; color: #886C47; padding: 24rpx; border-radius: 20rpx; font-size: 23rpx; line-height: 1.65; }
.alert-heading { font-weight: 730; margin-bottom: 9rpx; }
.exercise-top { display: flex; align-items: center; justify-content: space-between; }
.exercise-heading { flex: 1; min-width: 0; }
.exercise-time { color: #8C9DA2; font-size: 22rpx; margin-bottom: 9rpx; }
.exercise-title { font-size: 30rpx; font-weight: 700; }
.dosage { margin-top: 11rpx; font-size: 24rpx; color: #287B74; }
.check { border: 2rpx solid #C7DAD6; border-radius: 11rpx; height: 44rpx; width: 44rpx; text-align: center; line-height: 40rpx; color: #fff; margin-left: 14rpx; }
.check.checked { background: #287B74; border-color: #287B74; }
.description { margin-top: 21rpx; padding-top: 20rpx; border-top: 1rpx solid #EEF2F1; color: #667D81; line-height: 1.65; font-size: 24rpx; }
.search { color: #287B73; font-size: 22rpx; padding-top: 25rpx; line-height: 1.5; }
.stop { background: #FFF; border: 1rpx solid #D7E2E1; color: #68817E; border-radius: 22rpx; margin: 38rpx 0 10rpx; font-size: 27rpx; }
.stop::after { border: 0; }
