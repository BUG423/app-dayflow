<view class="page plans">
  <view class="page-title">我的计划</view>
  <view class="subtle">先写下要做的事，再安排合适的时间。</view>
  <view class="button-row plan-toolbar">
    <button class="button-primary create-schedule" bindtap="onCreateSchedule">添加安排</button>
    <button class="button-secondary plan-tools-toggle" bindtap="onToggleTools">计划工具</button>
  </view>
  <view wx:if="{{errorMessage}}" class="form-error">{{errorMessage}}</view>
  <view wx:if="{{saveNotice}}" class="save-notice">{{saveNotice}}</view>

  <view wx:if="{{!editorVisible && draftResumeAvailable}}" class="draft-resume card"><view><view class="setting-title">上次填写的内容还在</view><view class="field-help">可以接着填写，确认前不会修改计划。</view></view><view class="draft-actions"><button class="resume-draft" bindtap="onResumeDraft">继续填写</button><button class="discard-draft" bindtap="onDiscardDraft">放弃本次填写</button></view></view>

  <view wx:if="{{editorVisible}}" class="card editor wizard-editor" id="schedule-editor">
    <view class="editor-heading"><text class="editor-title">{{editingId ? '修改安排' : '添加安排'}}</text><button class="close-editor" size="mini" bindtap="onCloseEditor" aria-label="暂时关闭并保留填写内容">稍后继续</button></view>
    <view class="wizard-steps" aria-label="填写进度">
      <button wx:for="{{wizardSteps}}" wx:key="*this" class="wizard-step {{editorStep === index ? 'current' : ''}} {{editorStep > index ? 'completed' : ''}}" size="mini" data-step="{{index}}" disabled="{{(editingExceptionDate && !exceptionOnly) || index > furthestStep}}" bindtap="onWizardStep" aria-label="第{{index + 1}}步，{{item}}"><text class="step-number">{{editorStep > index ? '✓' : index + 1}}</text><text class="step-name">{{item}}</text></button>
    </view>
    <view class="wizard-summary {{summaryExpanded ? 'is-open' : ''}}">
      <view class="summary-heading"><text>已填写</text><button class="summary-toggle" size="mini" bindtap="onToggleSummary" aria-label="{{summaryExpanded ? '收起填写摘要' : '展开填写摘要'}}">{{summaryExpanded ? '收起摘要 ⌃' : '查看摘要 ⌄'}}</button></view>
      <view wx:if="{{!summaryExpanded}}" class="summary-compact">{{wizardSummary || '每完成一步，内容会显示在这里。'}}</view>
      <view wx:else class="summary-rows"><button wx:for="{{summaryRows}}" wx:key="label" class="summary-row" size="mini" data-step="{{item.step}}" disabled="{{(editingExceptionDate && !exceptionOnly) || item.step > furthestStep}}" bindtap="onWizardStep"><text class="summary-label">{{item.label}}</text><text class="summary-value">{{item.value || '待填写'}}</text><text class="summary-arrow">›</text></button></view>
    </view>
    <view wx:if="{{exceptionOnly}}" class="saved-date-note">安排日期：{{editingExceptionDate}}</view>
    <view wx:if="{{wizardError}}" class="wizard-error" aria-live="polite">{{wizardError}}</view>

    <view wx:if="{{editorStep === 0}}" class="wizard-page" data-step="0">
      <view class="step-heading">你想做什么？</view>
      <view class="form-field"><label class="field-label">事项名称</label><input class="form-input schedule-name" value="{{title}}" data-field="title" bindinput="onEditorInput" maxlength="60" placeholder="例如：工作、加班、练习吉他" /></view>
      <view wx:if="{{simpleMode}}" class="checkable-setting"><view><view class="field-label">需要打卡</view><view class="field-help">完成后可以勾选。</view></view><switch class="schedule-checkable" checked="{{kindIndex !== 0}}" color="#2563EB" bindchange="onCheckableChange" aria-label="需要打卡" /></view>
      <view wx:else class="field-help existing-content-note">已保留原有的{{blockOptions.length}}个时段和执行内容，需要时可在“更多设置”中修改。</view>
    </view>

    <view wx:if="{{editorStep === 1}}" class="wizard-page" data-step="1">
      <view class="step-heading">什么时候做？</view>
      <view wx:if="{{!editingExceptionDate}}" class="form-field"><label class="field-label">{{repeatModeIndex === 0 ? '安排在哪一天' : '从哪天开始'}}</label><picker class="schedule-date-picker" mode="date" value="{{effectiveFrom}}" data-field="effectiveFrom" bindchange="onEditorInput"><view class="form-picker">{{effectiveFrom}}　⌄</view></picker></view>
      <view wx:if="{{dateSelectionHint && !editingExceptionDate}}" class="date-selection-hint">{{dateSelectionHint}}</view>
      <view wx:if="{{blockOptions.length > 1}}" class="form-field"><label class="field-label">正在调整的时段</label><picker class="block-picker" range="{{blockOptions}}" range-key="label" value="{{editingBlockIndex}}" bindchange="onEditorBlockChange"><view class="form-picker">{{blockOptions[editingBlockIndex].label}}　⌄</view></picker></view>
      <view class="form-grid time-picker-row"><view class="form-field"><label class="field-label">开始时间</label><picker class="start-time-picker" mode="multiSelector" range="{{startTimeRange}}" value="{{startTimeIndices}}" disabled="{{timePickerDisabled}}" bindchange="onStartTimeChange" bindcolumnchange="onStartTimeColumnChange"><view class="form-picker {{timePickerDisabled ? 'picker-disabled' : ''}}">{{start || '选择开始时间'}}　⌄</view></picker></view><view class="form-field"><label class="field-label">结束时间</label><picker class="end-time-picker" mode="multiSelector" range="{{endTimeRange}}" value="{{endTimeIndices}}" disabled="{{timePickerDisabled}}" bindchange="onEndTimeChange" bindcolumnchange="onEndTimeColumnChange"><view class="form-picker {{timePickerDisabled ? 'picker-disabled' : ''}}">{{end || '选择结束时间'}}　⌄</view></picker></view></view>
      <view wx:if="{{availabilityHint}}" class="availability-hint">{{availabilityHint}}</view>
      <button wx:if="{{suggestedTimeLabel}}" class="suggested-slot" size="mini" bindtap="onChooseSuggestedTime">{{suggestedTimeLabel}}</button>
      <view wx:if="{{freeWindows.length}}" class="free-windows"><view class="field-label">也可以直接选空闲时间</view><view class="free-slot-list"><block wx:for="{{freeWindows}}" wx:key="index"><button wx:if="{{index < 3 || allFreeWindowsVisible}}" class="free-slot" size="mini" data-index="{{index}}" bindtap="onChooseFreeWindow">{{item.start}}–{{item.end}}</button></block></view><button wx:if="{{freeWindows.length > 3}}" class="more-free-windows" size="mini" bindtap="onToggleFreeWindows">{{allFreeWindowsVisible ? '收起' : '查看其他空闲时间'}}</button></view>
      <view wx:else class="availability-empty">{{timeAvailabilityError || '这一天已有安排。选择时间后，可以确认替换旧安排。'}}</view>
      <view wx:if="{{timeAvailabilityError && freeWindows.length}}" class="wizard-error">{{timeAvailabilityError}}</view>
      <view wx:if="{{occupiedSlots.length}}" class="occupied-list"><button class="occupied-toggle" size="mini" bindtap="onToggleOccupied">{{occupiedVisible ? '收起已占用时间' : '查看已占用时间'}}<text>{{occupiedVisible ? '⌃' : '⌄'}}</text></button><view wx:if="{{occupiedVisible}}"><view wx:for="{{occupiedSlots}}" wx:key="key" class="busy-item" aria-disabled="true"><view class="busy-copy"><view class="busy-title">{{item.title}}</view><view wx:if="{{item.scheduleTitle || item.date}}" class="busy-context">{{item.scheduleTitle}} {{item.date}}</view></view><text class="busy-time">{{item.start}}–{{item.end}}</text></view><button wx:if="{{occupiedMoreCount > 0}}" class="more-occupied" size="mini" bindtap="onShowMoreOccupied">查看其余{{occupiedMoreCount}}项</button></view></view>
    </view>

    <view wx:if="{{editorStep === 2}}" class="wizard-page" data-step="2">
      <view class="step-heading">要重复吗？</view>
      <view wx:if="{{!editingExceptionDate}}">
        <view class="repeat-mode" aria-label="重复安排"><button wx:for="{{repeatOptions}}" wx:key="*this" class="repeat-option {{repeatModeIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="onChooseRepeat" aria-pressed="{{repeatModeIndex === index}}"><text>{{item}}</text><text class="repeat-choice-mark">{{repeatModeIndex === index ? '✓' : ''}}</text></button></view>
        <view wx:if="{{repeatModeIndex === 3}}" class="form-field"><label class="field-label">选择星期</label><view class="repeat-days"><button wx:for="{{weekdayOptions}}" wx:key="value" size="mini" class="repeat-day {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onToggleWeekday">{{item.label}}</button></view></view>
      </view>
      <button class="advanced-toggle" size="mini" bindtap="onToggleAdvanced">{{advancedVisible ? '收起更多设置' : '更多设置（选填）'}}<text>{{advancedVisible ? '⌃' : '⌄'}}</text></button>
      <view wx:if="{{advancedVisible}}" class="advanced-editor">
        <view wx:if="{{repeatModeIndex !== 0 && !editingExceptionDate}}" class="form-field"><label class="field-label">重复到哪天（选填）</label><picker class="effective-to-picker" mode="date" value="{{effectiveTo || effectiveFrom}}" start="{{effectiveFrom}}" data-field="effectiveTo" bindchange="onEditorInput"><view class="form-picker">{{effectiveTo || '一直重复'}}　⌄</view></picker><button wx:if="{{effectiveTo}}" class="clear-repeat-end" size="mini" bindtap="onClearRepeatEnd">改为一直重复</button></view>
        <view class="form-field"><label class="field-label">分类（选填）</label><input class="form-input category-input" value="{{category}}" data-field="category" bindinput="onEditorInput" maxlength="20" placeholder="例如：工作、兴趣、训练、生活" /></view>
        <view wx:if="{{!editingExceptionDate}}" class="form-field"><label class="field-label">整组安排的名称</label><input class="form-input" value="{{scheduleTitle}}" data-field="scheduleTitle" bindinput="onEditorInput" maxlength="60" placeholder="不填则使用事项名称" /></view>
        <view class="form-field"><label class="field-label">编辑哪个时段</label><picker class="block-picker" range="{{blockOptions}}" range-key="label" value="{{editingBlockIndex}}" bindchange="onEditorBlockChange"><view class="form-picker">{{blockOptions[editingBlockIndex].label || '当前时段'}}　⌄</view></picker></view>
        <view class="form-field"><label class="field-label">当前时段名称</label><input class="form-input" value="{{title}}" data-field="title" bindinput="onEditorInput" maxlength="60" placeholder="填写这个时段的名称" /></view>
        <view class="button-row"><button class="button-secondary" bindtap="onAddEditorBlock">添加时段</button><button class="button-secondary danger-text" disabled="{{blockOptions.length <= 1}}" bindtap="onRemoveEditorBlock">删除当前时段</button></view>
        <button class="block-time-link" size="mini" data-step="1" bindtap="onWizardStep">返回时间页调整 {{start}}–{{end}}</button>
        <view class="form-field"><label class="field-label">如何执行</label><picker class="kind-picker" range="{{kindOptions}}" value="{{kindIndex}}" bindchange="onKindChange"><view class="form-picker">{{kindOptions[kindIndex]}}　⌄</view></picker></view><view class="field-help">只占时间不参与打卡；多项任务可分别完成；按步骤执行会按时间排列。</view>
        <view wx:if="{{kindIndex !== 0}}" class="task-editor"><view class="section-heading">{{kindIndex === 1 ? '需要分别完成的任务' : '按顺序执行的步骤'}}</view><view class="field-help">步骤时间应在已选时段内，系统会按开始时间排列。</view>
          <view wx:for="{{actionRows}}" wx:for-item="action" wx:for-index="actionIndex" wx:key="id" class="action-editor"><view class="action-editor-heading"><text>第{{actionIndex + 1}}项</text><button class="inline-button danger-text" size="mini" data-index="{{actionIndex}}" bindtap="onRemoveAction">删除此项</button></view><view class="form-field"><label class="field-label">名称</label><input class="form-input" value="{{action.title}}" data-index="{{actionIndex}}" data-field="title" bindinput="onActionInput" maxlength="80" placeholder="填写任务或步骤名称" /></view><view class="form-grid"><view class="form-field"><label class="field-label">开始</label><picker mode="time" value="{{action.start}}" data-index="{{actionIndex}}" data-field="start" bindchange="onActionInput"><view class="form-picker">{{action.start}}　⌄</view></picker></view><view class="form-field"><label class="field-label">结束</label><picker mode="time" value="{{action.end}}" data-index="{{actionIndex}}" data-field="end" bindchange="onActionInput"><view class="form-picker">{{action.end}}　⌄</view></picker></view></view><view class="form-field"><label class="field-label">组数、次数或时长（选填）</label><input class="form-input" value="{{action.dosage}}" data-index="{{actionIndex}}" data-field="dosage" bindinput="onActionInput" maxlength="100" placeholder="例如：3组，每组10次" /></view><view class="form-field"><label class="field-label">执行说明（选填）</label><textarea class="form-textarea" value="{{action.description}}" data-index="{{actionIndex}}" data-field="description" bindinput="onActionInput" maxlength="1000" placeholder="记下方法或目标" /></view><view class="form-field"><label class="field-label">器材（选填）</label><input class="form-input" value="{{action.equipment}}" data-index="{{actionIndex}}" data-field="equipment" bindinput="onActionInput" maxlength="100" placeholder="例如：弹力带、稳固座椅" /></view><view class="form-field"><label class="field-label">示范检索词（选填）</label><input class="form-input" value="{{action.searchKeyword}}" data-index="{{actionIndex}}" data-field="searchKeyword" bindinput="onActionInput" maxlength="100" placeholder="便于查找示范的中文关键词" /></view><view class="form-field"><label class="field-label">注意事项（选填）</label><textarea class="form-textarea short-textarea" value="{{action.safety}}" data-index="{{actionIndex}}" data-field="safety" bindinput="onActionInput" maxlength="500" placeholder="记下停止或调整的提示" /></view></view>
          <button class="button-secondary add-action" bindtap="onAddAction">{{kindIndex === 1 ? '添加任务' : '添加步骤'}}</button>
        </view>
      </view>
    </view>

    <view wx:if="{{editorStep === 3 && (!editingExceptionDate || exceptionOnly)}}" class="wizard-page" data-step="3"><view class="step-heading">这样安排，可以吗？</view><view class="review-summary"><view wx:for="{{summaryRows}}" wx:key="label" class="review-row"><text class="summary-label">{{item.label}}</text><text class="summary-value">{{item.value || '未填写'}}</text></view></view><view wx:if="{{reviewBlocks.length > 1}}"><view class="review-section-title">包含以下安排</view><view wx:for="{{reviewBlocks}}" wx:key="id" class="review-block"><view class="review-block-heading"><text class="review-block-title">{{item.title}}</text><text class="review-block-time">{{item.start}}–{{item.end}}</text></view></view></view><view wx:if="{{reviewExceptions.length}}" class="field-help saved-adjustments">已保留之前设置的{{reviewExceptions.length}}个日期调整。</view></view>

    <view wx:if="{{editorStep > 0 && overwriteRows.length}}" class="overwrite-panel {{overwriteConfirmed ? 'is-approved' : ''}}"><view class="overwrite-heading">{{overwriteConfirmed ? '已确认替换，保存后生效' : '将替换' + overwriteRows.length + '个旧时段'}}</view><view class="field-help">移除完整旧时段，其他安排和执行记录保留。</view><block wx:for="{{overwriteRows}}" wx:key="key"><view wx:if="{{index < 3 || overwriteExpanded}}" class="overwrite-row"><view>{{item.title}} {{item.start}}–{{item.end}}</view><view class="field-help">{{item.scope}}</view></view></block><button wx:if="{{overwriteRows.length > 3}}" class="overwrite-details" bindtap="onToggleOverwriteDetails">{{overwriteExpanded ? '收起' : '查看全部' + overwriteRows.length + '个时段'}}</button><button wx:if="{{overwriteRequired}}" class="overwrite-confirm" bindtap="onConfirmOverwrite">确认替换这些安排</button></view>
    <view wx:if="{{editorStep > 0 && overwriteError && !conflicts.length}}" class="wizard-error">{{overwriteError}}</view>
    <view wx:if="{{conflicts.length}}" class="conflict-panel" aria-live="polite"><view class="conflict-heading">这组内容的时间需要调整</view><view wx:for="{{conflicts}}" wx:key="key" class="conflict-item"><view>{{item.message || item.label}}</view><view class="conflict-plan">{{item.title}} · {{item.start}}–{{item.end}}</view><view wx:if="{{item.date || item.scheduleTitle}}" class="field-help">{{item.date}} {{item.scheduleTitle}}</view></view><button wx:if="{{editorStep !== 1}}" class="conflict-time-link" size="mini" data-step="1" bindtap="onWizardStep">返回时间页调整</button></view>
    <button class="discard-draft editor-discard" bindtap="onDiscardDraft">放弃本次填写</button><view class="wizard-footer"><button wx:if="{{editorStep > 0}}" class="button-secondary wizard-back" bindtap="onWizardBack">上一步</button><button wx:if="{{editorStep < 3}}" class="button-primary wizard-next" disabled="{{wizardNextDisabled || saving}}" loading="{{saving}}" bindtap="onWizardNext">{{wizardNextLabel || '下一步'}}</button><button wx:if="{{editorStep === 3 && (!editingExceptionDate || exceptionOnly)}}" class="button-primary save-schedule" disabled="{{saving || !!timeAvailabilityError || conflicts.length > 0 || overwriteRequired || !!overwriteError}}" loading="{{saving}}" bindtap="onSaveSchedule">确认并保存</button></view>
  </view>

  <view wx:if="{{toolsVisible}}" class="card plan-tools"><view class="tool-heading">计划工具</view><button class="tool-row import-toggle" bindtap="onToggleImport">导入或导出<text>›</text></button><button class="tool-row example-toggle" bindtap="onPreviewExample">查看示例计划<text>›</text></button><button class="tool-row versions-toggle" bindtap="onToggleVersions">计划版本<text>›</text></button></view>

  <view wx:if="{{toolsVisible && importVisible}}" class="card import-panel">
    <view class="editor-title">{{examplePreview ? '查看示例计划' : '导入或导出计划'}}</view>
    <view class="field-help">{{examplePreview ? '这是可修改的示例。先查看内容，确认使用才会替换未来安排；已有执行历史保留。' : '粘贴标准模板内容，先查看校验结果，再确认导入。'}}</view>
    <textarea wx:if="{{!examplePreview}}" class="form-textarea import-content" value="{{importText}}" bindinput="onImportInput" maxlength="262145" placeholder="在这里粘贴模板内容" />
    <view wx:if="{{!examplePreview}}" class="button-row"><button class="button-primary preview-import" bindtap="onPreviewImport">校验并预览</button><button class="button-secondary" bindtap="onExportTemplate">复制当前模板</button></view>
    <view wx:if="{{examplePreview}}" class="example-schedules"><view wx:for="{{exampleRows}}" wx:key="id" class="example-day"><view class="example-title">{{item.title}}</view><view wx:for="{{item.blocks}}" wx:for-item="block" wx:key="id" class="example-block"><view><text>{{block.title}}</text><text class="example-kind">{{block.label}}</text></view><view class="example-time">{{block.time}}</view></view></view></view>
    <view wx:if="{{importPreview}}" class="import-preview">
      <view wx:if="{{importPreview.ok}}" class="preview-success">校验通过</view>
      <view wx:else class="danger-text">请先修正以下问题</view>
      <view wx:if="{{importPreview.ok}}" class="preview-summary">{{importPreview.summary.schedules}}条重复规则 · {{importPreview.summary.blocks}}个时间块 · {{importPreview.summary.tasks}}项任务 · {{importPreview.summary.actions}}个步骤</view>
      <view wx:for="{{importPreview.errors}}" wx:key="*this" class="preview-error">{{item}}</view>
      <view wx:for="{{importPreview.warnings}}" wx:key="*this" class="preview-warning">{{item}}</view>
      <view wx:if="{{importPreview.ok}}" class="field-help">确认后更新尚未执行的安排，已有历史记录保留。</view>
      <button class="button-primary confirm-import" disabled="{{!importPreview.ok}}" bindtap="onConfirmImport">{{examplePreview ? '使用这份示例计划' : '确认导入'}}</button>
    </view>
  </view>

  <view class="section-heading">已设安排 <text class="version-label">第{{templateVersion || 1}}版</text></view>
  <view wx:if="{{!schedules.length}}" class="card empty-state">还没有安排。点上方“添加安排”，写下第一件事。</view>
  <view wx:for="{{schedules}}" wx:key="id" class="card schedule-card">
    <view class="schedule-title">{{item.title}}</view>
    <view class="schedule-meta">{{item.weekLabel}}</view>
    <view class="schedule-meta">{{item.blockLabel}}</view>
    <view class="schedule-meta">{{item.effectiveLabel}}</view>
    <view class="button-row"><button class="button-secondary schedule-edit" data-id="{{item.id}}" bindtap="onEditSchedule">修改</button><button class="button-secondary schedule-delete danger-text" data-id="{{item.id}}" bindtap="onDeleteSchedule">删除</button></view>
  </view>

  <view wx:if="{{deferredItems.length}}" class="section-heading">待重新安排</view>
  <view wx:for="{{deferredItems}}" wx:key="recordKey" class="card deferred-item">
    <view class="schedule-title">{{item.title}}</view>
    <view class="schedule-meta">原日期：{{item.date}} · 延期至：{{item.deferredTo}}</view>
    <button class="button-secondary deferred-schedule" data-date="{{item.date}}" data-id="{{item.targetId}}" data-target-date="{{item.deferredTo}}" bindtap="onScheduleDeferred">安排到目标日期</button>
  </view>

  <view wx:if="{{toolsVisible && versionsVisible && versions.length}}" class="section-heading">计划版本</view>
  <view wx:if="{{toolsVisible && versionsVisible && versions.length}}" class="card version-history"><view wx:for="{{versions}}" wx:key="version" class="version-row"><view class="version-info"><view>{{item.label}}</view><view class="version-time">{{item.updatedLabel}}</view></view><text wx:if="{{item.isCurrent}}" class="current-version">当前使用</text><button wx:else class="restore-version" data-version="{{item.version}}" bindtap="onRestoreVersion">恢复为新版本</button></view></view>

  <button class="training-toggle" bindtap="onToggleTraining">本周训练安排<text>{{trainingVisible ? '收起 ⌃' : '展开 ⌄'}}</text></button>
  <view wx:if="{{trainingVisible}}">
  <view wx:for="{{days}}" wx:key="date" class="day-card card {{item.selected ? 'selected' : ''}}">
    <view class="day-head"><text class="weekday">{{item.weekday}}</text><text class="date">{{item.date}}</text><text wx:if="{{item.selected}}" class="today-tag">今天</text></view>
    <view class="day-title">{{item.title}}</view>
    <view class="day-meta">{{item.minutes}} · {{item.actionCount}}个步骤</view>
  </view>
  </view>
  <button class="go-today" bindtap="onViewToday">打开今日时间轴</button>
</view>
