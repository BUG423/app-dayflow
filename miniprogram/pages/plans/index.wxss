.plans { padding-top: 24px; }
.plans .page-title { margin-bottom: 8px; }
.notice { background: var(--color-primary-soft); border-color: var(--color-primary-soft); margin-top: 20px; }
.notice-title { color: var(--color-primary); font-size: 15px; font-weight: 600; }
.notice-body { font-size: 14px; line-height: 1.8; margin-top: 8px; color: var(--color-muted); }
.day-card { margin-bottom: 10px; border: 1px solid var(--color-border); }
.day-card.selected { border-color: var(--color-primary); }
.day-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.weekday { font-size: 16px; font-weight: 650; }
.date { color: var(--color-muted); font-size: 13px; }
.today-tag { margin-left: auto; color: var(--color-primary); background: var(--color-primary-soft); font-size: 12px; padding: 3px 9px; border-radius: 20px; }
.day-title { margin-top: 10px; font-size: 16px; font-weight: 600; line-height: 1.5; }
.day-meta { color: var(--color-muted); font-size: 13px; margin-top: 4px; }
.go-today { background: var(--color-primary); color: #FFFFFF; border-radius: 12px; margin-top: 18px; min-height: 44px; padding: 11px 16px; font-size: 15px; display: flex; align-items: center; justify-content: center; }
.plan-toolbar { margin-bottom: 20px; }
.plan-toolbar button { flex: 1; }
.editor { border-color: var(--color-border); margin-top: 16px; }
.editor-heading, .action-editor-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.editor-title { font-size: 18px; font-weight: 650; }
.close-editor, .inline-button { min-height: 44px; padding: 10px 8px; color: var(--color-primary); background: transparent; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.form-grid { display: flex; gap: 12px; }
.form-grid > .form-field { flex: 1; min-width: 0; }
.repeat-days { display: flex; flex-wrap: wrap; gap: 6px; }
.repeat-day { min-height: 44px; min-width: 44px; padding: 10px; background: var(--color-bg); color: var(--color-muted); border-radius: 10px; }
.repeat-day.selected { background: var(--color-primary); color: #FFFFFF; }
.exception-add { display: flex; gap: 10px; align-items: center; }
.exception-add picker { flex: 1; min-width: 0; }
.exception-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 14px; border-bottom: 1px solid var(--color-border); }
.action-editor { padding: 14px 0; border-bottom: 1px solid var(--color-border); }
.action-editor-heading { font-size: 15px; font-weight: 600; }
.short-textarea { height: 88px; }
.add-action { width: 100%; margin-top: 16px; }
.editor-notice { margin-top: 16px; }
.danger-text { color: var(--color-danger); }
.version-label { color: var(--color-muted); font-size: 13px; font-weight: 400; margin-left: 6px; }
.schedule-title { font-size: 16px; font-weight: 600; overflow-wrap: break-word; }
.schedule-meta { font-size: 13px; color: var(--color-muted); margin-top: 6px; line-height: 1.7; }
.schedule-card .button-row button { flex: 1; }
.import-content { margin-top: 12px; height: 180px; }
.import-preview { border-top: 1px solid var(--color-border); margin-top: 16px; padding-top: 16px; }
.preview-success { color: var(--color-success); font-weight: 600; }
.preview-summary, .preview-error, .preview-warning { font-size: 13px; line-height: 1.8; margin-top: 8px; overflow-wrap: break-word; }
.preview-error { color: var(--color-danger); }
.preview-warning { color: var(--color-warning); }
.confirm-import { width: 100%; margin-top: 14px; }
@media (max-width: 360px) { .form-grid { gap: 8px; } .form-picker { padding-left: 9px; padding-right: 9px; font-size: 14px; } }
.deferred-schedule { width: 100%; margin-top: 12px; }
.version-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 8px 0; font-size: 14px; }
.version-row + .version-row { border-top: 1px solid var(--color-border); }
.version-time { color: var(--color-muted); font-size: 12px; text-align: right; }
.form-error { margin-bottom: 16px; padding: 12px 14px; color: var(--color-danger); background: var(--color-danger-soft); border-radius: 10px; font-size: 14px; line-height: 1.7; }
.version-info { flex: 1; min-width: 0; }
.version-info .version-time { text-align: left; margin-top: 4px; line-height: 1.6; overflow-wrap: break-word; }
.current-version { flex-shrink: 0; color: var(--color-primary); font-size: 12px; padding: 4px 8px; background: var(--color-primary-soft); border-radius: 10px; }
.restore-version { min-height: 44px; max-width: 124px; flex-shrink: 0; padding: 10px; color: var(--color-primary); background: var(--color-primary-soft); border-radius: 10px; font-size: 13px; display: flex; align-items: center; justify-content: center; }

/* Compact editing keeps the common path short; detailed rules are opt-in. */
.plans button { min-width: 0; max-width: 100%; }
.plans .plan-toolbar button { flex: 1 1 0; min-width: 0; padding-left: 10px; padding-right: 10px; }
.plans button.close-editor { width: 56px; min-width: 56px; max-width: 56px; flex: 0 0 56px; height: 44px; padding: 0; white-space: nowrap; }
.editor-heading .editor-title { min-width: 0; flex: 1; }
.checkable-setting { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; padding: 14px 0; border-top: 1px solid var(--color-border); }
.checkable-setting > view { flex: 1; min-width: 0; }
.checkable-setting .field-label { margin-bottom: 0; }
.checkable-setting switch { flex-shrink: 0; }
.plans button.advanced-toggle { width: 100%; min-height: 44px; padding: 10px 0; margin-top: 8px; color: var(--color-primary); background: transparent; display: flex; align-items: center; justify-content: space-between; font-size: 14px; }
.advanced-editor { border-top: 1px solid var(--color-border); padding-top: 2px; }
.editor-save-row .save-schedule { width: 100%; }
.editor-notice { font-size: 12px; }
.plan-tools { padding-top: 8px; padding-bottom: 8px; }
.tool-heading { font-size: 14px; color: var(--color-muted); padding: 8px 0; }
.plans button.tool-row { width: 100%; min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 0; background: transparent; color: var(--color-text); font-size: 15px; }
.tool-row + .tool-row { border-top: 1px solid var(--color-border); }
.plans button.training-toggle { width: 100%; min-height: 48px; display: flex; align-items: center; justify-content: space-between; padding: 10px 2px; margin-top: 18px; color: var(--color-text); background: transparent; font-size: 16px; font-weight: 600; }
.training-toggle text { font-size: 13px; font-weight: 400; color: var(--color-muted); }
.plans button.repeat-day { flex: 0 0 calc((100% - 18px) / 4); min-width: 44px; height: 44px; padding: 0 4px; font-size: 14px; display: flex; align-items: center; justify-content: center; }
.exception-row > text { flex: 1; min-width: 0; overflow-wrap: break-word; }
.plans button.inline-button { width: auto; max-width: 120px; min-width: 44px; flex: 0 0 auto; }
.plans button.restore-version { width: 112px; min-width: 112px; flex: 0 0 112px; }
.schedule-meta { overflow-wrap: break-word; }
@media (max-width: 360px) { .form-grid { flex-wrap: wrap; } .form-grid > .form-field { flex: 1 1 110px; } .repeat-mode .form-picker { font-size: 13px; } .exception-add { flex-wrap: wrap; } }

.example-day { padding: 14px 0; border-bottom: 1px solid var(--color-border); }
.example-title { font-size: 15px; font-weight: 600; margin-bottom: 8px; }
.example-block { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; padding: 5px 0; font-size: 14px; }
.example-block > view:first-child { min-width: 0; overflow-wrap: break-word; }
.example-kind { color: var(--color-muted); font-size: 12px; margin-left: 6px; }
.example-time { color: var(--color-muted); font-size: 13px; white-space: nowrap; }
.date-selection-hint, .save-notice { margin-top: 12px; padding: 12px; border-radius: 10px; background: var(--color-primary-soft); color: var(--color-primary); font-size: 13px; line-height: 1.7; overflow-wrap: break-word; }
.save-notice { margin-bottom: 16px; }
