.plans .step-heading { font-size: 20px; font-weight: 700; }
.plans .repeat-mode { display: flex; flex-direction: row; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.plans button.repeat-option { flex: 1 1 calc((100% - 10px) / 2); width: calc((100% - 10px) / 2); min-width: 0; min-height: 51px; margin: 0; padding: 13px 12px; border: 1px solid #E1E4D9; border-radius: 16px; background: #FFFFFF; color: var(--color-text); font-size: 15px; font-weight: 600; line-height: 1.5; display: flex; align-items: center; justify-content: space-between; gap: 8px; text-align: left; }
.plans button.repeat-option.selected { border-color: var(--color-primary); background: var(--color-primary-soft); color: var(--color-primary); }
.plans .repeat-choice-mark { color: var(--color-primary); }
.plans button.custom-repeat { width: 100%; min-height: 48px; display: flex; align-items: center; justify-content: space-between; margin: 8px 0 0; padding: 10px 12px; background: var(--color-sky-soft); color: var(--color-sky); border-radius: 13px; font-size: 14px; }
.plans button.custom-repeat.is-selected { border: 1px solid var(--color-sky); }
.plans button.free-slot { border-color: #C8DDE7; color: var(--color-sky); background: var(--color-sky-soft); border-radius: 14px; }
.plans .busy-item { background: #F4F6F0; border-color: #E4E8DC; border-radius: 14px; }
.plans .wizard-footer { border-color: #EAE1D0; box-shadow: 0 -4px 18px rgba(90, 70, 30, .035); }
.plans .wizard-footer button { border-radius: 16px; }
.plans .overwrite-panel { border-radius: 17px; background: #EFF8F4; border-color: #CBE3D5; }
.plans .overwrite-heading { color: var(--color-success); }
.plans .review-summary { border-radius: 17px; background: #FFFCF5; border-color: #EEE4D1; }
.plans .schedule-card { border-radius: 21px; }
.plans .schedule-title { font-size: 17px; font-weight: 650; }
.plans .disclosure-label { display: flex; align-items: center; gap: 7px; font-size: 13px; color: var(--color-muted); }
.plans .advanced-toggle, .plans .occupied-toggle { gap: 12px; }
@media (max-width: 360px) { .plans .repeat-mode { gap: 8px; } .plans button.repeat-option { padding: 12px 10px; font-size: 14px; } .plans .step-heading { font-size: 19px; } }

