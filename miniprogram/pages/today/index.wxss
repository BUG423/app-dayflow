.today { padding-top: 42rpx; }
.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30rpx; }
.brand { font-size: 20rpx; letter-spacing: 5rpx; color: #277B74; font-weight: 800; margin-bottom: 12rpx; }
.brand-dot { letter-spacing: 0; font-size: 13rpx; }
.page-title { margin-bottom: 10rpx; }
.today-jump { border: 1rpx solid #BED6D2; border-radius: 40rpx; padding: 13rpx 25rpx; color: #277B74; font-size: 24rpx; }
.calendar { padding-bottom: 22rpx; }
.week-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25rpx; }
.week-name { font-size: 28rpx; font-weight: 650; }
.week-arrows { display: flex; gap: 12rpx; }
.week-arrow { width: 50rpx; height: 50rpx; border-radius: 50%; background: #F3F6F7; text-align: center; line-height: 44rpx; color: #557077; font-size: 38rpx; }
.weekday-row { display: flex; justify-content: space-between; }
.weekday { width: 78rpx; height: 110rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 23rpx; }
.weekday.active { background: #277B74; color: #fff; }
.weekday-label { font-size: 21rpx; opacity: .72; margin-bottom: 7rpx; }
.weekday-number { font-size: 30rpx; font-weight: 650; }
.today-dot { height: 6rpx; width: 6rpx; border-radius: 100%; margin-top: 7rpx; background: transparent; }
.today-dot.visible { background: #EFB96A; }
.focus { background: #E8F4EF; padding: 33rpx; }
.focus-top { display: flex; justify-content: space-between; align-items: center; }
.focus-label { font-size: 23rpx; color: #32776E; font-weight: 700; }
.focus-stat { color: #578A7D; font-size: 22rpx; }
.focus-title { font-size: 39rpx; font-weight: 720; margin-top: 20rpx; }
.focus-time { font-size: 25rpx; color: #54766F; margin-top: 9rpx; }
.progress-track { height: 10rpx; background: #D0E4D9; overflow: hidden; margin-top: 26rpx; border-radius: 20rpx; }
.progress-fill { height: 100%; background: #287B73; border-radius: 20rpx; }
.focus-bottom { font-size: 22rpx; color: #638D82; margin-top: 13rpx; }
.section-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.section-hint { color: #96A6AB; font-size: 21rpx; }
.timeline-row { display: flex; align-items: stretch; margin-bottom: 10rpx; }
.time-column { width: 95rpx; flex-shrink: 0; padding-top: 24rpx; display: flex; flex-direction: column; gap: 4rpx; }
.time-main { font-size: 25rpx; font-weight: 680; }
.time-end { font-size: 20rpx; color: #9AA9AD; }
.timeline-mark { width: 26rpx; display: flex; align-items: center; flex-direction: column; }
.node { width: 13rpx; height: 13rpx; background: #C7D6D4; border-radius: 50%; margin-top: 35rpx; flex-shrink: 0; }
.node-accent { background: #2A8075; }
.timeline-line { margin-top: 8rpx; width: 2rpx; background: #E0E9E8; flex: 1; min-height: 30rpx; }
.block-card { background: white; flex: 1; min-width: 0; border-radius: 22rpx; margin-bottom: 16rpx; padding: 24rpx; box-shadow: 0 5rpx 16rpx rgba(36,70,65,.035); }
.block-fixed { background: #F0F3F4; box-shadow: none; }
.block-header { display: flex; justify-content: space-between; align-items: center; min-height: 60rpx; }
.block-titles { flex: 1; min-width: 0; }
.block-title { font-size: 28rpx; font-weight: 650; }
.block-meta { font-size: 21rpx; color: #94A2A7; margin-top: 8rpx; }
.expand-arrow { color: #6C8D88; font-size: 35rpx; padding-left: 12rpx; }
.fixed-badge { color: #99A6AA; font-size: 20rpx; }
.active-badge { display: inline-block; color: #227B73; font-size: 20rpx; margin-top: 9rpx; }
.action-list { margin-top: 21rpx; border-top: 1rpx solid #EFF2F2; padding-top: 7rpx; }
.action-line { display: flex; align-items: center; padding: 15rpx 0; }
.check-button { height: 36rpx; width: 36rpx; flex-shrink: 0; border: 2rpx solid #CAD8D6; border-radius: 10rpx; display: flex; justify-content: center; align-items: center; font-size: 26rpx; color: #fff; margin-right: 18rpx; }
.check-button.checked { background: #287B73; border-color: #287B73; }
.action-content { flex: 1; min-width: 0; }
.action-title { font-size: 25rpx; }
.action-done { text-decoration: line-through; color: #A5B1B4; }
.action-time { font-size: 20rpx; color: #91A0A4; margin-top: 5rpx; }
.detail-link { color: #277B74; font-size: 24rpx; text-align: right; padding: 19rpx 0 7rpx; }
.safety-notice { padding: 25rpx; color: #86959A; line-height: 1.7; font-size: 21rpx; }
