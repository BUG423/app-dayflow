page {
  background: #F6F8F8;
  color: #223638;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 15px;
  line-height: 1.55;
}
view, text, button, input, textarea { box-sizing: border-box; }
button { margin: 0; font-size: 15px; line-height: 1.4; }
button::after { border: none; }
switch { min-height: 44px; }
.page { padding: 24px 16px 32px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
.page-title { font-size: 26px; font-weight: 700; line-height: 1.3; overflow-wrap: break-word; }
.subtle { color: #657C7E; font-size: 14px; line-height: 1.6; }
.card { background: #FFFFFF; border: 1px solid #E9EEEE; border-radius: 16px; padding: 16px; margin-bottom: 12px; }
.section-heading { margin: 24px 0 12px; font-size: 18px; font-weight: 650; line-height: 1.4; }
.pill { background: #E8F3EF; color: #226D65; padding: 4px 10px; border-radius: 20px; font-size: 13px; }
.muted { color: #768A8D; }
.form-field { margin-top: 16px; }
.field-label { display: block; color: #465E61; font-size: 14px; font-weight: 600; margin-bottom: 8px; }
.form-input, .form-textarea, .form-picker { width: 100%; min-height: 44px; padding: 11px 12px; border: 1px solid #CCDAD8; border-radius: 10px; background: #FFFFFF; color: #223638; font-size: 15px; }
.form-textarea { height: 112px; line-height: 1.6; }
.field-help { margin-top: 6px; color: #6A8082; font-size: 13px; line-height: 1.6; }
.button-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
.button-primary, .button-secondary, .button-danger { min-height: 44px; padding: 11px 16px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 600; }
.button-primary { background: #28786E; color: #FFFFFF; }
.button-secondary { background: #EDF3F1; color: #286A63; border: 1px solid #D5E3DF; }
.button-danger { background: #FFF1EF; color: #A1473D; border: 1px solid #F0D7D1; }
.button-primary[disabled], .button-secondary[disabled], .button-danger[disabled] { opacity: .45; }
.empty-state { padding: 28px 16px; color: #6A8082; text-align: center; font-size: 14px; line-height: 1.8; }
.notice-text { color: #6A8082; font-size: 13px; line-height: 1.7; }
@media (max-width: 360px) {
  .page { padding-left: 12px; padding-right: 12px; }
  .card { padding: 14px; }
  .page-title { font-size: 24px; }
}
.modal-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 20; background: rgba(24, 45, 40, .32); display: flex; justify-content: center; align-items: flex-end; }
.modal-card { width: 100%; max-width: 600px; background: #FFFFFF; border-radius: 20px 20px 0 0; padding: 22px 18px 24px; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
.modal-title { font-size: 19px; font-weight: 650; line-height: 1.5; }
.modal-subtitle { font-size: 14px; color: #6A8082; margin-top: 6px; overflow-wrap: break-word; }
.modal-card .button-row button { flex: 1; }
